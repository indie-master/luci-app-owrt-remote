# Copy to .env with docker/install.sh. Never commit the real .env.
RO_IMAGE=router-orchestrator-hub:unbuilt
RO_STATE_DIR=/opt/router-orchestrator/data
RO_PORT=18089
RO_PUBLIC_URL=https://hub.example.invalid
RO_XRAY_BACKEND=external_readonly

# For the unified stack, copy this file to a dedicated root-owned directory
# (0700) as stack.env (0600). Reserve a new RO_STACK_NAME and point
# RO_STATE_DIR at an empty or absent direct child of that directory.
# Choose standalone, external-stream or external-only. Generate nginx files
# with tools/orchestrator_stack_config.py. Use docker/manager.py stack with
# --env-file /absolute/path/stack.env for validation and lifecycle operations.
# External ingress snippets require review and separate operator application.
# RO_STACK_MODE=external-stream
# RO_STACK_NAME=ro-stage
# RO_XRAY_IMAGE=<reviewed repository>@sha256:<digest>
# RO_XRAY_CONFIG_DIR=/path/to/isolated/xray
# RO_XRAY_ASSET_DIR=/path/to/isolated/assets
# RO_TLS_DIR=/path/to/isolated/tls
# RO_WSS_PORT=18444
# The following nginx settings apply only to standalone and external-stream.
# RO_NGINX_IMAGE=<reviewed repository>@sha256:<digest>
# RO_NGINX_CONF=/path/to/new/render-directory/nginx.conf
# RO_TLS_PORT=18445
# RO_NGINX_HEALTH_PORT=18189
# RO_STREAM_ROUTES=reality.example.invalid:24443
