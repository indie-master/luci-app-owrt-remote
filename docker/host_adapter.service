# Opt-in read-only host control service. NOT auto-installed or enabled.
# Future Xray apply/restart requires a separately reviewed override.
[Unit]
Description=Router Orchestrator read-only host adapter
After=network-online.target owrt-remote-xray.service
ConditionPathExists=/opt/router-orchestrator/host-adapter/host_adapter.py

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=router-orchestrator
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/python3 /opt/router-orchestrator/host-adapter/host_adapter.py --peer-uid 23088
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/router-orchestrator
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
# CAP_CHOWN is needed to assign the UNIX socket group to UID 23088.
# Deliberately not writable: /etc/xray and /var/lib/owrt-remote.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
# Never grant CAP_SYS_ADMIN or unrestricted shell execution.
# Safe write integration will require an independently reviewed new unit.

[Install]
WantedBy=multi-user.target
