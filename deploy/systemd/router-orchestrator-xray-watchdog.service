[Unit]
Description=Router Orchestrator pinned Xray core watchdog
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/router-orchestrator/src/docker/xray_watchdog.py
TimeoutStartSec=95
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/xray /opt/router-orchestrator /run/docker.sock /var/run/docker.sock
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
