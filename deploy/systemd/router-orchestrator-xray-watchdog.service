[Unit]
Description=Router Orchestrator pinned Xray core watchdog
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/opt/router-orchestrator/managed-stack.conf
ExecStart=/usr/bin/python3 /opt/router-orchestrator/src/docker/xray_watchdog.py
TimeoutStartSec=240
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/router-orchestrator
ReadOnlyPaths=/opt/router-orchestrator/src
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
