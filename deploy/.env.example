# Router Orchestrator single-stack configuration (copy to /opt/router-orchestrator/.env)
# Keep the file mode 0600. Never commit real hostnames, tokens or private keys.
RO_HUB_IMAGE=router-orchestrator-hub:release
RO_XRAY_IMAGE=router-orchestrator-xray:26.3.27-belt
RO_NGINX_IMAGE=nginx:1.29-alpine
RO_PUBLIC_URL=https://router.example.org
RO_PORT=8088
RO_STATE_DIR=/opt/router-orchestrator/data
RO_XRAY_CONFIG_DIR=/etc/xray
RO_XRAY_ASSET_DIR=/usr/local/share/xray
RO_TERMINAL_KEY_PATH=/opt/router-orchestrator/host-terminal/id_ed25519
RO_TERMINAL_KNOWN_HOSTS=/opt/router-orchestrator/host-terminal/known_hosts
# Embedded HTTP behind an outer reverse proxy:
RO_NGINX_CONF=/opt/router-orchestrator/src/deploy/nginx/embedded.conf
# Outer nginx stream TLS passthrough alternative, bind loopback :18445:
# RO_NGINX_CONF=/opt/router-orchestrator/src/deploy/nginx/embedded-stream-tls.conf
# Dedicated standalone VPS only, after :80/:443 ownership checks:
# RO_NGINX_CONF=/opt/router-orchestrator/src/deploy/nginx/standalone.conf
RO_NGINX_HEALTH_PORT=18089
RO_TLS_DIR=/opt/router-orchestrator/tls
