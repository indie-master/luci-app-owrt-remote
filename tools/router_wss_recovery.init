#!/bin/sh /etc/rc.common
# Isolated rollback supervisor. Does not replace the original owrt-remote service.
USE_PROCD=1
START=08
STOP=99
ST=/etc/router-orchestrator/wss-pilot
TX=/usr/libexec/ro-wss-transaction

boot() {
  # A pending switch at boot is a failure, not an approval.
  [ ! -e "$ST/pending" ] || /bin/sh "$TX" boot-recover || return 1
  start "$@"
}

start_service() {
  [ -e "$ST/armed" ] || return 0
  [ -f "$ST/deadline" ] && [ -f "$TX" ] || return 1
  procd_open_instance wss-deadline
  procd_set_param command /bin/sh "$TX" watchdog
  # Restart crash-looping watchdog without extending persisted deadline.
  procd_set_param respawn 3600 2 10
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
