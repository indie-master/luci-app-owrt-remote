#!/bin/sh /etc/rc.common
# DEVELOPMENT BLUEPRINT ONLY. Never install this file into a live /etc/init.d.
# An eventual reviewed service will supervise a local rollback watchdog using
# OpenWrt procd. The existing v119 owrt-remote service is never touched.
USE_PROCD=1
START=08
STOP=99

start_service() {
    # Explicitly forbid any live use of this unfinished prototype.
    [ "${RO_PROCD_TEST_MODE:-0}" = 1 ] || {
        echo 'ro-pilot-recovery: TEST-ONLY blueprint, live registration disabled' >&2
        return 1
    }
    root="${RO_TEST_ROOT:-}"
    case "$root" in
        /|''|*[!/-]*/*/../*|*/../*|*/..)
            echo 'ro-pilot-recovery: unsafe synthetic root' >&2
            return 1
            ;;
        /*) ;;
        *) echo 'ro-pilot-recovery: synthetic root must be absolute' >&2; return 1 ;;
    esac
    state="$root/etc/router-orchestrator/upgrade"
    [ -f "$state/transaction.sh" ] || return 1
    # A boot during pending installation must roll back BEFORE the old
    # reverse tunnel starts. This path never registers a new watchdog.
    if [ -f "$state/pending" ]; then
        /bin/sh "$state/transaction.sh" boot-recover || return 1
        return 0
    fi
    [ -f "$state/armed" ] || return 0
    procd_open_instance rollback-watchdog
    procd_set_param command /bin/sh "$state/transaction.sh" watchdog
    # Limit restarts until a fail-closed crash-handling policy is specified.
    # NEVER treat respawn alone as proof of a reliable deadline.
    procd_set_param respawn 3600 2 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
