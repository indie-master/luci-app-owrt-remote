#!/bin/sh /etc/rc.common
# DEVELOPMENT BLUEPRINT ONLY. Never install this file into a live /etc/init.d.
# An eventual reviewed service will supervise a local rollback watchdog using
# OpenWrt procd. The existing v119 owrt-remote service is never touched.
USE_PROCD=1
START=08
STOP=99

# Distinguish real boot from a service start within the same uptime:
# a live apply may already have written "pending" when procd is registered.
# Only boot-time pending is proof that the previous process did not finish.
boot() {
    RO_PILOT_BOOT=1 start "$@"
}

validate_synthetic_state() {
    # Strictly test-only: never register or stop a real OpenWrt service.
    [ "${RO_PROCD_TEST_MODE:-0}" = 1 ] || {
        echo 'ro-pilot-recovery: TEST-ONLY blueprint, live registration disabled' >&2
        return 1
    }
    root="${RO_TEST_ROOT:-}"
    case "$root" in
        /|''|*/../*|*/..|*//*)
            echo 'ro-pilot-recovery: unsafe synthetic root' >&2
            return 1
            ;;
        /tmp/ro-transaction-test-*/router|/tmp/procd-recovery-test-*/synthetic-router|/tmp/ro-pilot-fixture.*/router) ;;
        *) echo 'ro-pilot-recovery: synthetic root must be dedicated /tmp fixture' >&2; return 1 ;;
    esac
    [ -d "$root" ] && [ ! -L "$root" ] || return 1
    canonical="$(cd -P "$root" && pwd -P)" || return 1
    [ "$canonical" = "$root" ] || return 1
    [ -f "$root/.ro-pilot-synthetic-root" ] &&
        [ ! -L "$root/.ro-pilot-synthetic-root" ] || return 1
    state="$root/etc/router-orchestrator/upgrade"
    [ -f "$state/transaction.sh" ] && [ ! -L "$state/transaction.sh" ] || return 1
    [ -f "$state/secondary-guard.sh" ] && [ ! -L "$state/secondary-guard.sh" ] || return 1
    [ -f "$root/.ro-pilot-synthetic-root" ] || return 1
}

# Explicit post-confirm cleanup for the separate coordinator. This is NOT
# stop_service(): OpenWrt rc.common calls procd_kill even if stop_service
# fails, so placing a pending guard there would give false safety.
# The test-only cleanup must first verify that commit is fully complete.
cleanup_confirmed() {
    validate_synthetic_state || return 1
    if [ ! -f "$state/confirmed" ] || [ -e "$state/pending" ] || [ -e "$state/armed" ]; then
        echo 'ro-pilot-recovery: pending or unconfirmed transaction; refuse cleanup' >&2
        return 1
    fi
    # Simulated procd_kill, never actual service management in this branch.
    procd_kill ro-pilot-recovery rollback-watchdog || return 1
    procd_kill ro-pilot-recovery independent-deadline-guard
}

start_service() {
    validate_synthetic_state || return 1
    # At *boot* an unfinished transaction must be rolled back before the
    # regular v119 service begins. During the same boot a pending apply
    # needs the watchdog, not an immediate rollback.
    if [ "${RO_PILOT_BOOT:-0}" = 1 ] && [ -f "$state/pending" ]; then
        RO_TEST_MODE=1 RO_TEST_ROOT="$root" RO_TEST_ROUTER_ID=main \
            RO_TEST_TRANSPORT=tcp RO_TEST_PORT=18443 \
            /bin/sh "$state/transaction.sh" boot-recover || return 1
        return 0
    fi
    [ -f "$state/armed" ] || return 0
    [ -s "$state/deadline.uptime" ] || {
        echo 'ro-pilot-recovery: missing pinned deadline' >&2
        return 1
    }
    procd_open_instance rollback-watchdog
    procd_set_param command /bin/sh "$state/transaction.sh" watchdog
    # Supply synthetic root to the supervised process. No real /etc paths.
    procd_set_param env RO_TEST_MODE=1 RO_TEST_ROOT="$root" \
        RO_TEST_ROUTER_ID=main RO_TEST_TRANSPORT=tcp RO_TEST_PORT=18443
    # "0" means unlimited retries in OpenWrt procd. Keep a fixed
    # two-second delay to avoid a tight crash loop while pending recovery.
    # The original deadline is never reset by either worker.
    procd_set_param respawn 3600 2 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Independent process with a separate implementation, not a child of
    # rollback-watchdog. It can restore if the primary worker is in a crash
    # loop. The procd manager itself is still a shared failure domain;
    # persistent boot recovery remains mandatory.
    procd_open_instance independent-deadline-guard
    procd_set_param command /bin/sh "$state/secondary-guard.sh"
    procd_set_param env RO_TEST_MODE=1 RO_TEST_ROOT="$root" \
        RO_TEST_ROUTER_ID=main RO_TEST_TRANSPORT=tcp RO_TEST_PORT=18443
    procd_set_param respawn 3600 2 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
